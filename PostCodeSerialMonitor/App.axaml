    <Application.DataTemplates>
        <local:ViewLocator/>
    </Application.DataTemplates>

    <Application.Styles>
        <FluentTheme />
        <Style Selector="Window">
            <Setter Property="TransparencyLevelHint" Value="AcrylicBlur" />
            <Setter Property="BorderBrush" Value="White" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="SelectableTextBlock">
            <Setter Property="Foreground" Value="{DynamicResource SeverityInfoBrush}" />
        </Style>
        <Style Selector="SelectableTextBlock.severity-warning">
            <Setter Property="Foreground" Value="{DynamicResource SeverityWarningBrush}" />
        </Style>
        <Style Selector="SelectableTextBlock.severity-error">
            <Setter Property="Foreground" Value="{DynamicResource SeverityErrorBrush}" />
        </Style>
    </Application.Styles>
</Application>