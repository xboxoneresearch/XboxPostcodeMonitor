<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PostCodeSerialMonitor.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:assets="clr-namespace:PostCodeSerialMonitor.Assets"
        xmlns:converters="clr-namespace:PostCodeSerialMonitor.Views.Converters"
        xmlns:objconv="clr-namespace:Avalonia.Data.Converters;assembly=Avalonia.Base"
        xmlns:models="using:PostCodeSerialMonitor.Models"
        mc:Ignorable="d" d:DesignWidth="850" d:DesignHeight="900"
        x:Class="PostCodeSerialMonitor.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="{x:Static assets:Resources.XboxPostCodeSerialMonitor}"
        FontFamily="Consolas,Menlo,Monospace"
        Width="850" Height="900">

    <Window.Resources>
        <converters:BooleanNegationConverter x:Key="BooleanNegationConverter" />
        <converters:BooleanToTextConverter x:Key="BooleanToTextConverter" />
    </Window.Resources>

    <Window.Styles>
        <!-- FluentTheme (via Avalonia.Fonts.Inter) sets FontFamily on TextBlock through a
             Style setter, which outranks the value inherited from Window.FontFamily below. -->
        <Style Selector="TextBlock">
            <Setter Property="FontFamily" Value="Consolas,Menlo,Monospace"/>
        </Style>
        <Style Selector="Button.logRow">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="4,1"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.logRow:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#20808080"/>
        </Style>
        <Style Selector="Button.logRow.selected /template/ ContentPresenter">
            <Setter Property="Background">
                <SolidColorBrush Color="{DynamicResource SystemAccentColor}" Opacity="0.25"/>
            </Setter>
        </Style>
        <Style Selector="TextBlock.logText">
            <Setter Property="Foreground" Value="{DynamicResource SeverityInfoBrush}" />
        </Style>
        <Style Selector="TextBlock.logText.severity-warning">
            <Setter Property="Foreground" Value="{DynamicResource SeverityWarningBrush}" />
        </Style>
        <Style Selector="TextBlock.logText.severity-error">
            <Setter Property="Foreground" Value="{DynamicResource SeverityErrorBrush}" />
        </Style>
    </Window.Styles>

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <DockPanel Margin="10" LastChildFill="True">
        <!-- Top controls -->
        <StackPanel Orientation="Vertical" DockPanel.Dock="Top" Spacing="8">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Top" Spacing="8">
                <ComboBox Width="180"
                        ItemsSource="{Binding SerialPorts}"
                        SelectedItem="{Binding SelectedPort, Mode=TwoWay}"
                        IsEnabled="{Binding IsConnected, Converter={StaticResource BooleanNegationConverter}}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="models:PortInfo">
                            <TextBlock Text="{Binding Name}" ToolTip.Tip="{Binding Description}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <Button Command="{Binding RefreshPortsCommand}" IsEnabled="{Binding IsConnected, Converter={StaticResource BooleanNegationConverter}}">
                    <StackPanel Orientation="Horizontal" Spacing="0">
                        <PathIcon Data="{StaticResource arrow_sync_regular}" Margin="0,0,10,0"/>
                        <TextBlock Text="{x:Static assets:Resources.RefreshPorts}"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding ToggleConnectionCommand}" IsEnabled="{Binding CanToggleConnection}">
                    <StackPanel Orientation="Horizontal" Spacing="0">
                        <PathIcon Data="{Binding ConnectionButtonIcon}" Margin="0,0,10,0"/>
                        <TextBlock Text="{Binding ConnectionButtonText}"/>
                    </StackPanel>
                </Button>
                <ComboBox Width="150"
                        ItemsSource="{Binding ConsoleModels}"
                        SelectedItem="{Binding SelectedConsoleModel, Mode=TwoWay}"
                        IsEnabled="{Binding IsConnected, Converter={StaticResource BooleanNegationConverter}}"
                        Margin="20,0,0,0"/>
                <Button Command="{Binding ShowConfigurationCommand}" Margin="20,0,0,0">
                    <StackPanel Orientation="Horizontal" Spacing="0">
                        <PathIcon Data="{StaticResource settings_regular}" Margin="0,0,10,0"/>
                        <TextBlock Text="{x:Static assets:Resources.Configuration}"/>
                    </StackPanel>
                </Button>
                <!-- Keeping it clean (for now?) by not showing Pico firmware options
                <CheckBox Content="Mirror display" IsChecked="{Binding MirrorDisplay}" Margin="20,0,0,0" IsEnabled="false"/>
                <CheckBox Content="Portrait mode" IsChecked="{Binding PortraitMode}" IsEnabled="false"/>
                <CheckBox Content="Print timestamps" IsChecked="{Binding PrintTimestamps}" IsEnabled="false"/>
                -->
            </StackPanel>
            <TextBlock Text="Logs" FontWeight="Bold"/>
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Top" Spacing="4">
                <Button Margin="20,0,0,0"
                        Command="{Binding SaveLogCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="0">
                        <PathIcon Data="{StaticResource save_regular}" Margin="0,0,10,0"/>
                        <TextBlock Text="{x:Static assets:Resources.SaveLog}"/>
                    </StackPanel>
                </Button>
                <Button Margin="20,0,0,0"
                        Command="{Binding ClearLogCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="0">
                        <PathIcon Data="{StaticResource erase_regular}" Margin="0,0,10,0"/>
                        <TextBlock Text="{x:Static assets:Resources.ClearLog}"/>
                    </StackPanel>
                </Button>
                <Button Margin="20,0,0,0"
                        x:Name="AutoScrollButton"
                        IsVisible="False"
                        Click="OnAutoScrollButtonClick">
                    <StackPanel Orientation="Horizontal" Spacing="0">
                        <PathIcon Data="{StaticResource textbox_align_bottom_regular}" Margin="0,0,10,0"/>
                        <TextBlock Text="Auto-scroll"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </StackPanel>

        <!-- Footer -->
        <Border DockPanel.Dock="Bottom" 
                BorderBrush="{DynamicResource SystemAccentColor}" 
                BorderThickness="0,1,0,0" 
                Padding="5" 
                Margin="0,10,0,0">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="20">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <TextBlock Text="{x:Static assets:Resources.PicoFirmware} " FontWeight="Bold"/>
                        <TextBlock>
                            <Run Text="{Binding FirmwareVersion}"/>
                            <Run Text=" "/>
                            <Run Text="{Binding BuildDate}"/>
                        </TextBlock>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <TextBlock Text="{x:Static assets:Resources.MetadataUpdate} " FontWeight="Bold"/>
                        <TextBlock Text="{Binding MetadataLastUpdate}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="5"
                                Background="Transparent"
                                Cursor="Hand"
                                PointerPressed="OnAppVersionPointerPressed">
                        <TextBlock Text="{x:Static assets:Resources.AppVersion} " FontWeight="Bold"/>
                        <TextBlock Text="{Binding AppVersion}"/>
                    </StackPanel>
                    <Button Content="{x:Static assets:Resources.Debug}"
                            Command="{Binding ShowDebugMenuCommand}"
                            IsVisible="{Binding DebugModeUnlocked}"/>
                </StackPanel>
                <Grid DockPanel.Dock="Top" Margin="8,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Margin="0,5,0,0"
                        Tag="https://xboxresearch.com"
                        Cursor="Hand"
                        TextDecorations="Underline"
                        Foreground="{DynamicResource SystemAccentColor}"
                        Text="{x:Static assets:Resources.VisitXboxResearch}"
                        PointerPressed="OnHyperlinkClick"/>
                    <TextBlock Grid.Column="1" Margin="0,5,0,0"
                        Tag="https://ko-fi.com/tuxuser"
                        Cursor="Hand"
                        TextDecorations="Underline"
                        Foreground="{DynamicResource SystemAccentColor}"
                        Text="{x:Static assets:Resources.ConsiderDonation}"
                        PointerPressed="OnHyperlinkClick"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Main monitor view -->
        <Grid RowDefinitions="Auto,*,Auto" Margin="0,10,0,0">
            <StackPanel Grid.Row="0" x:Name="scrollViewer" Margin="0,0,0,5">
                <TextBlock Text="Monitor"
                          FontWeight="Bold"/>
                <Border Height="1"
                        Background="{DynamicResource SystemAccentColor}"
                        Margin="0,2,0,0"/>
            </StackPanel>
            <Grid Grid.Row="1" IsSharedSizeScope="True">
                <ScrollViewer x:Name="LogScrollViewer"
                             HorizontalScrollBarVisibility="Disabled"
                             VerticalScrollBarVisibility="Auto">
                    <ItemsRepeater x:Name="LogItemsRepeater" ItemsSource="{Binding LogEntries}">
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate>
                                <Button Classes="logRow"
                                        Classes.selected="{Binding IsSelected}"
                                        Command="{Binding $parent[ItemsRepeater].DataContext.SelectLogEntryCommand}"
                                        CommandParameter="{Binding}">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" SharedSizeGroup="LogColTimestamp"/>
                                                <ColumnDefinition Width="Auto" SharedSizeGroup="LogColFlavor"/>
                                                <ColumnDefinition Width="Auto" SharedSizeGroup="LogColIndex"/>
                                                <ColumnDefinition Width="Auto" SharedSizeGroup="LogColCode"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding TimestampText}"
                                                     Classes="logText"
                                                     Classes.severity-warning="{Binding IsWarning}"
                                                     Classes.severity-error="{Binding IsError}"
                                                     IsVisible="{Binding $parent[ItemsRepeater].DataContext.ShowTimestamps}"
                                                     FontFamily="Consolas,Menlo,Monospace"
                                                     FontSize="16"
                                                     Margin="0,0,4,0"
                                                     Opacity="0.7"
                                                     VerticalAlignment="Top"/>
                                            <TextBlock Grid.Column="1" Text="{Binding FlavorText}"
                                                     Classes="logText"
                                                     Classes.severity-warning="{Binding IsWarning}"
                                                     Classes.severity-error="{Binding IsError}"
                                                     FontFamily="Consolas,Menlo,Monospace"
                                                     FontSize="16"
                                                     Margin="0,0,4,0"
                                                     VerticalAlignment="Top"/>
                                            <TextBlock Grid.Column="2" Text="{Binding CodeHexText}"
                                                     Classes="logText"
                                                     Classes.severity-warning="{Binding IsWarning}"
                                                     Classes.severity-error="{Binding IsError}"
                                                     FontFamily="Consolas,Menlo,Monospace"
                                                     FontSize="16"
                                                     Margin="0,0,4,0"
                                                     VerticalAlignment="Top"/>
                                            <!-- NewLine / bottom-panel mode: just the name -->
                                            <TextBlock Grid.Column="3" Text="{Binding NameText}"
                                                     Classes="logText"
                                                     Classes.severity-warning="{Binding IsWarning}"
                                                     Classes.severity-error="{Binding IsError}"
                                                     IsVisible="{Binding $parent[ItemsRepeater].DataContext.IsDescriptionInlineMode, Converter={StaticResource BooleanNegationConverter}}"
                                                     FontFamily="Consolas,Menlo,Monospace"
                                                     FontSize="16"
                                                     VerticalAlignment="Top"
                                                     TextWrapping="Wrap"/>
                                            <!-- Inline mode: name + description, truncated with an ellipsis until expanded -->
                                            <TextBlock Grid.Column="3" Text="{Binding InlinePreviewText}"
                                                     Classes="logText"
                                                     Classes.severity-warning="{Binding IsWarning}"
                                                     Classes.severity-error="{Binding IsError}"
                                                     IsVisible="{Binding $parent[ItemsRepeater].DataContext.IsDescriptionInlineMode}"
                                                     FontFamily="Consolas,Menlo,Monospace"
                                                     FontSize="16"
                                                     VerticalAlignment="Top"
                                                     TextWrapping="NoWrap"
                                                     TextTrimming="CharacterEllipsis"/>
                                        </Grid>
                                        <!-- Inline mode, expanded: full (possibly multi-line) description -->
                                        <StackPanel IsVisible="{Binding $parent[ItemsRepeater].DataContext.IsDescriptionInlineMode}">
                                            <SelectableTextBlock Text="{Binding Description}"
                                                     Classes="logText"
                                                     Classes.severity-warning="{Binding IsWarning}"
                                                     Classes.severity-error="{Binding IsError}"
                                                     IsVisible="{Binding IsSelected}"
                                                     FontFamily="Consolas,Menlo,Monospace"
                                                     FontSize="16"
                                                     Margin="0,2,0,2"
                                                     TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <!-- New-line mode: description always shown on the next line -->
                                        <StackPanel IsVisible="{Binding $parent[ItemsRepeater].DataContext.IsDescriptionNewLineMode}">
                                            <SelectableTextBlock Text="{Binding Description}"
                                                     Classes="logText"
                                                     Classes.severity-warning="{Binding IsWarning}"
                                                     Classes.severity-error="{Binding IsError}"
                                                     IsVisible="{Binding HasDescription}"
                                                     FontFamily="Consolas,Menlo,Monospace"
                                                     FontSize="16"
                                                     Margin="0,2,0,2"
                                                     TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </ScrollViewer>
            </Grid>

            <!-- Description of the clicked log entry (bottom-panel mode only) -->
            <StackPanel Grid.Row="2"
                    IsVisible="{Binding IsDescriptionBottomPanelMode}">
                <Border BorderBrush="{DynamicResource SystemAccentColor}"
                        BorderThickness="0,1,0,0"
                        Padding="0,8,0,0"
                        Margin="0,8,0,0"
                        IsVisible="{Binding SelectedLogEntry, Converter={x:Static objconv:ObjectConverters.IsNotNull}}">
                    <StackPanel Spacing="4">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{x:Static assets:Resources.TimestampLabel}" FontFamily="Consolas,Menlo,Monospace" Opacity="0.7"/>
                            <SelectableTextBlock Text="{Binding SelectedLogEntry.TimestampText}" FontFamily="Consolas,Menlo,Monospace" Opacity="0.7"/>
                        </StackPanel>
                        <SelectableTextBlock Text="{Binding SelectedLogEntry.CodeText}" FontFamily="Consolas,Menlo,Monospace" FontWeight="Bold"/>
                        <SelectableTextBlock Text="{Binding SelectedLogEntry.Description}" FontFamily="Consolas,Menlo,Monospace" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </DockPanel>
</Window>